DATABASE_URL=postgresql://creativebuilds_app:YOUR_PASSWORD@localhost:5432/creativebuilds
JWT_SECRET=change-this-to-a-long-random-string
PORT=3021
NODE_ENV=production
# Cross-subdomain SSO (studio, www, app)
COOKIE_DOMAIN=.creativebuilds.dev
STUDIO_URL=https://studio.creativebuilds.dev
ADMIN_URL=https://admin.creativebuilds.dev
WWW_URL=https://www.creativebuilds.dev
APP_URL=https://app.creativebuilds.dev
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
# Content Engine AI Assist — OG images (Pexels primary, Unsplash fallback)
PEXELS_API_KEY=your-pexels-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
GITHUB_TOKEN=ghp_optional-for-higher-rate-limits
ODYSSEUS_ROOT=/home/pi/Desktop/Odysseus

# Outbound email (Resend) — tickets, newsletter, merch orders
# Until creativebuilds.dev is verified in Resend, NOTIFY_EMAIL must be your Resend account email
RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=hello@creativebuilds.dev
# NOTIFY_FROM=CreativeBuilds <notifications@creativebuilds.dev>  # after domain verification

# Cal.diy (self-hosted Cal.com) — lead follow-up bookings + webhooks
# CAL_API_URL=https://cal.creativebuilds.dev/api/v2
# CAL_API_KEY=cal_xxxxxxxx
# CAL_FOLLOWUP_EVENT_TYPE_ID=123
# CAL_WEBHOOK_SECRET=long-random-shared-secret
# CAL_HOST_EMAIL=hello@creativebuilds.dev
# CAL_HOST_NAME=Ryan Baldwin

# Stripe (payments: Blitz Calls, merch, hosting subscriptions)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_CLIENT_ID=ca_your_stripe_connect_client_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Facebook Page MCP (Odysseus admin — set in Odysseus MCP env, not committed)
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
